#!/usr/bin/env bash
# One Piece GRUB theme setup.
# Supports Fedora, Ubuntu, Linux Mint, Debian, Arch (and derivatives such as
# Manjaro, EndeavourOS, Kali, Zorin, openSUSE) and dual-boot with Windows.
#
# Usage:
#   sudo ./setup zoro          install the Zoro theme
#   sudo ./setup luffy         install the original Luffy theme (default)
#   ./setup list               show all themes
#   sudo ./setup remove        remove the theme
#   ./setup build zoro DIR     only assemble the theme into DIR (e.g. for NixOS)
#
# After the first install the same command is available system-wide:
#   sudo onepiece-setup sea
set -euo pipefail

THEME_NAME="one-piece"
SRC_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SHARE_DIR="/usr/share/one-piece-grub"
GLOBAL_CMD="/usr/local/bin/onepiece-setup"
GRUB_DEFAULT_CFG="/etc/default/grub"

info()  { printf '\033[1;33m[*]\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;31m[!]\033[0m %s\n' "$*"; }
die()   { warn "$*"; exit 1; }

list_themes() {
    echo "Available themes:"
    for d in "$SRC_DIR"/themes/*/; do
        name="$(basename "$d")"
        title="$(sed -n 's/.*text = "~ \(.*\) ~".*/\1/p' "$d/theme.txt")"
        printf '  %-12s %s\n' "$name" "${title:-Original One Piece theme}"
    done
}

usage() {
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    echo
    list_themes
}

# Accept a few friendly aliases.
resolve_theme() {
    case "$1" in
        merry|going-merry|going_merry) echo goingmerry ;;
        strawhat|straw_hat|monkey_d_luffy|monkey-d-luffy) echo straw-hat ;;
        default|original) echo luffy ;;
        *) echo "$1" ;;
    esac
}

# assemble_theme THEME DEST: shared files from the repository root, then the
# theme's own files on top, then its background.
assemble_theme() {
    rm -rf "$2"
    mkdir -p "$2"
    cp -a "$SRC_DIR"/theme.txt "$SRC_DIR"/*.pf2 \
          "$SRC_DIR"/select_*.png "$SRC_DIR"/terminal_box_*.png \
          "$SRC_DIR"/icons "$2"/
    cp -a "$SRC_DIR/themes/$1"/. "$2"/
    rm -f "$2/background"
    cp -a "$SRC_DIR/backgrounds/$(cat "$SRC_DIR/themes/$1/background").png" "$2/background.png"
}

check_theme() {
    [ -d "$SRC_DIR/themes/$1" ] || { list_themes; die "Unknown theme: $1"; }
}

ACTION="${1:-luffy}"
case "$ACTION" in
    build)
        [ $# -eq 3 ] || die "Usage: $0 build <theme> <directory>"
        THEME="$(resolve_theme "$2")"
        check_theme "$THEME"
        assemble_theme "$THEME" "$3"
        ok "Theme '$THEME' assembled in $3"
        exit 0
        ;;
    -h|--help|help) usage; exit 0 ;;
    list|--list|-l) list_themes; exit 0 ;;
    remove|uninstall|--uninstall|-u) ACTION="remove" ;;
    *)
        THEME="$(resolve_theme "$ACTION")"
        check_theme "$THEME"
        ACTION="install"
        ;;
esac

[ "$(id -u)" -eq 0 ] || die "Please run as root: sudo $0 $*"

# --- Detect distribution ----------------------------------------------------
DISTRO_ID="unknown"
DISTRO_LIKE=""
if [ -r /etc/os-release ]; then
    . /etc/os-release
    DISTRO_ID="${ID:-unknown}"
    DISTRO_LIKE="${ID_LIKE:-}"
fi
info "Detected distribution: ${PRETTY_NAME:-$DISTRO_ID}"

if [ "$DISTRO_ID" = "nixos" ]; then
    cat <<EOF
NixOS manages GRUB declaratively. Assemble the theme into a folder:

  ./setup build ${THEME:-luffy} ./one-piece-theme

and add to configuration.nix:

  boot.loader.grub.theme = ./one-piece-theme;
  boot.loader.grub.useOSProber = true;   # detect Windows

then run: sudo nixos-rebuild switch
EOF
    exit 0
fi

# --- Detect GRUB layout -----------------------------------------------------
# Fedora / RHEL / openSUSE use "grub2-*" tools and /boot/grub2,
# Debian / Ubuntu / Mint / Arch use "grub-*" tools and /boot/grub.
if command -v grub2-mkconfig >/dev/null 2>&1 && [ -d /boot/grub2 ]; then
    GRUB_DIR="/boot/grub2"
    MKCONFIG="grub2-mkconfig"
elif command -v grub-mkconfig >/dev/null 2>&1; then
    GRUB_DIR="/boot/grub"
    MKCONFIG="grub-mkconfig"
else
    die "GRUB was not found. This system probably uses another bootloader
    (e.g. Pop!_OS uses systemd-boot). Install GRUB first."
fi
[ -f "$GRUB_DEFAULT_CFG" ] || die "$GRUB_DEFAULT_CFG not found."

THEME_DIR="$GRUB_DIR/themes/$THEME_NAME"

update_grub_cfg() {
    info "Regenerating GRUB configuration..."
    if command -v update-grub >/dev/null 2>&1; then
        update-grub
    else
        "$MKCONFIG" -o "$GRUB_DIR/grub.cfg"
    fi
    # Older Fedora/RHEL UEFI installs read a full grub.cfg from the ESP
    # instead of a stub that points to $GRUB_DIR/grub.cfg.
    local efi_cfg="/boot/efi/EFI/$DISTRO_ID/grub.cfg"
    if [ -f "$efi_cfg" ] && ! grep -q "configfile" "$efi_cfg"; then
        "$MKCONFIG" -o "$efi_cfg"
    fi
}

backup_default_cfg() {
    local backup="$GRUB_DEFAULT_CFG.bak.$(date +%Y%m%d%H%M%S)"
    cp -a "$GRUB_DEFAULT_CFG" "$backup"
    ok "Backup of $GRUB_DEFAULT_CFG saved to $backup"
}

# set_var KEY VALUE: replace an active KEY= line, or append one.
set_var() {
    if grep -qE "^[[:space:]]*$1=" "$GRUB_DEFAULT_CFG"; then
        sed -i -E "s|^[[:space:]]*$1=.*|$1=\"$2\"|" "$GRUB_DEFAULT_CFG"
    else
        echo "$1=\"$2\"" >> "$GRUB_DEFAULT_CFG"
    fi
}

get_var() {
    grep -E "^[[:space:]]*$1=" "$GRUB_DEFAULT_CFG" | tail -n1 | cut -d= -f2- | tr -d "\"'" || true
}

comment_var() {
    sed -i -E "s|^[[:space:]]*($1=.*)|#\1|" "$GRUB_DEFAULT_CFG"
}

# --- Remove -----------------------------------------------------------------
if [ "$ACTION" = "remove" ]; then
    backup_default_cfg
    comment_var GRUB_THEME
    rm -rf "$THEME_DIR"
    update_grub_cfg
    rm -f "$GLOBAL_CMD"
    rm -rf "$SHARE_DIR"
    ok "Theme removed."
    exit 0
fi

# --- Copy theme files -------------------------------------------------------
info "Installing the '$THEME' theme to $THEME_DIR"
assemble_theme "$THEME" "$THEME_DIR"

# Keep a copy of the themes so "onepiece-setup <theme>" works from anywhere.
if [ "$SRC_DIR" != "$SHARE_DIR" ]; then
    rm -rf "$SHARE_DIR"
    mkdir -p "$SHARE_DIR"
    cp -a "$SRC_DIR"/setup "$SRC_DIR"/theme.txt "$SRC_DIR"/*.pf2 \
          "$SRC_DIR"/select_*.png "$SRC_DIR"/terminal_box_*.png \
          "$SRC_DIR"/icons "$SRC_DIR"/themes "$SRC_DIR"/backgrounds "$SHARE_DIR"/
fi
mkdir -p "$(dirname "$GLOBAL_CMD")"
ln -sf "$SHARE_DIR/setup" "$GLOBAL_CMD"

# --- Configure /etc/default/grub --------------------------------------------
backup_default_cfg
set_var GRUB_THEME "$THEME_DIR/theme.txt"

# Themes need the graphical terminal. Fedora ships GRUB_TERMINAL_OUTPUT="console".
for var in GRUB_TERMINAL GRUB_TERMINAL_OUTPUT; do
    if [ "$(get_var $var)" = "console" ]; then
        comment_var "$var"
        ok "Disabled $var=console (required for graphical themes)"
    fi
done

[ -n "$(get_var GRUB_GFXMODE)" ] || set_var GRUB_GFXMODE "1920x1080,auto"

# Show the menu instead of hiding it (Ubuntu/Fedora hide it on single-OS systems).
if [ "$(get_var GRUB_TIMEOUT_STYLE)" = "hidden" ]; then
    set_var GRUB_TIMEOUT_STYLE "menu"
fi
timeout="$(get_var GRUB_TIMEOUT)"
if [ -z "$timeout" ] || [ "$timeout" = "0" ]; then
    set_var GRUB_TIMEOUT "10"
fi
if command -v grub2-editenv >/dev/null 2>&1; then
    grub2-editenv - unset menu_auto_hide 2>/dev/null || true
fi

# Windows dual-boot: GRUB >= 2.06 disables os-prober by default.
set_var GRUB_DISABLE_OS_PROBER "false"
if ! command -v os-prober >/dev/null 2>&1; then
    warn "os-prober is not installed, so Windows will not appear in the menu."
    case " $DISTRO_ID $DISTRO_LIKE " in
        *" fedora "*|*" rhel "*)  warn "Install it with: sudo dnf install os-prober" ;;
        *" debian "*|*" ubuntu "*) warn "Install it with: sudo apt install os-prober" ;;
        *" arch "*)               warn "Install it with: sudo pacman -S os-prober" ;;
        *" suse "*|*" opensuse "*) warn "Install it with: sudo zypper install os-prober" ;;
    esac
    warn "Then run this command again."
fi

update_grub_cfg
ok "'$THEME' theme installed. Reboot and set sail!"
ok "Switch themes any time with: sudo onepiece-setup <theme>"
