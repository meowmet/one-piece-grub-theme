#!/usr/bin/env bash
# One Piece GRUB theme setup.
# Detects the distribution, firmware, screen resolution and a Windows install,
# then configures GRUB to match. Supports Fedora, Ubuntu, Linux Mint, Debian,
# Arch (Manjaro, EndeavourOS, CachyOS, Garuda), openSUSE, Kali and more.
#
# Usage:
#   sudo ./setup               pick a theme from a menu
#   sudo ./setup zoro          install the Zoro theme
#   sudo ./setup random        install a random theme
#   ./setup list               show all themes
#   ./setup status             show what was detected and what is installed
#   sudo ./setup remove        remove the theme and undo every change
#   ./setup build zoro DIR     only assemble the theme into DIR (e.g. for NixOS)
#
# Options:
#   -y, --yes                  do not ask, install os-prober when Windows is found
#
# After the first install the same command is available system-wide:
#   sudo onepiece-setup sea
set -euo pipefail

THEME_NAME="one-piece"
SRC_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
SHARE_DIR="/usr/share/one-piece-grub"
GLOBAL_CMD="/usr/local/bin/onepiece-setup"
GRUB_DEFAULT_CFG="/etc/default/grub"
GRUB_DROPIN_DIR="/etc/default/grub.d"
BLOCK_BEGIN="# >>> one-piece-grub >>>"
BLOCK_END="# <<< one-piece-grub <<<"

info()  { printf '\033[1;33m[*]\033[0m %s\n' "$*"; }
ok()    { printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;31m[!]\033[0m %s\n' "$*"; }
die()   { warn "$*"; exit 1; }

themes() {
    for d in "$SRC_DIR"/themes/*/; do basename "$d"; done
}

theme_title() {
    sed -n 's/.*text = "~ \(.*\) ~".*/\1/p' "$SRC_DIR/themes/$1/theme.txt"
}

list_themes() {
    echo "Available themes:"
    for name in $(themes); do
        printf '  %-12s %s\n' "$name" "$(theme_title "$name")"
    done
}

usage() {
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    echo
    list_themes
}

# Accept a few friendly aliases.
resolve_theme() {
    case "$1" in
        merry|going-merry|going_merry) echo goingmerry ;;
        strawhat|straw_hat|monkey_d_luffy|monkey-d-luffy) echo straw-hat ;;
        default|original) echo luffy ;;
        random) themes | shuf -n1 ;;
        *) echo "$1" ;;
    esac
}

check_theme() {
    [ -d "$SRC_DIR/themes/$1" ] || { list_themes; die "Unknown theme: $1"; }
}

pick_theme() {
    local names i=1 choice
    mapfile -t names < <(themes)
    echo "Which crew member sets sail today?" >&2
    for name in "${names[@]}"; do
        printf '  %d) %-12s %s\n' "$i" "$name" "$(theme_title "$name")" >&2
        i=$((i + 1))
    done
    read -rp "Theme [1-${#names[@]}, default 1]: " choice
    choice="${choice:-1}"
    [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#names[@]}" ] \
        || die "Invalid choice: $choice"
    echo "${names[$((choice - 1))]}"
}

# assemble_theme THEME DEST: shared files from the repository root, then the
# theme's own files on top, then its background.
assemble_theme() {
    rm -rf "$2"
    mkdir -p "$2"
    cp -a "$SRC_DIR"/*.pf2 "$SRC_DIR"/terminal_box_*.png "$SRC_DIR"/icons "$2"/
    cp -a "$SRC_DIR/themes/$1"/. "$2"/
    rm -f "$2/background"
    cp -a "$SRC_DIR/backgrounds/$(cat "$SRC_DIR/themes/$1/background").png" "$2/background.png"
}

# --- Arguments --------------------------------------------------------------
ASSUME_YES=0
ARGS=()
for a in "$@"; do
    case "$a" in
        -y|--yes) ASSUME_YES=1 ;;
        *) ARGS+=("$a") ;;
    esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

ACTION="${1:-}"
case "$ACTION" in
    -h|--help|help) usage; exit 0 ;;
    list|--list|-l) list_themes; exit 0 ;;
    build)
        [ $# -eq 3 ] || die "Usage: $0 build <theme> <directory>"
        THEME="$(resolve_theme "$2")"
        check_theme "$THEME"
        assemble_theme "$THEME" "$3"
        ok "Theme '$THEME' assembled in $3"
        exit 0
        ;;
    status) ;;
    remove|uninstall|--uninstall|-u) ACTION="remove" ;;
    "")
        if [ -t 0 ] && [ "$ASSUME_YES" -eq 0 ]; then
            THEME="$(pick_theme)"
        else
            THEME="luffy"
        fi
        ACTION="install"
        ;;
    *)
        THEME="$(resolve_theme "$ACTION")"
        check_theme "$THEME"
        ACTION="install"
        ;;
esac

# --- Detect the system ------------------------------------------------------
DISTRO_ID="unknown"
DISTRO_LIKE=""
DISTRO_NAME="unknown"
if [ -r /etc/os-release ]; then
    # shellcheck disable=SC1091
    DISTRO_ID="$(. /etc/os-release; echo "${ID:-unknown}")"
    # shellcheck disable=SC1091
    DISTRO_LIKE="$(. /etc/os-release; echo "${ID_LIKE:-}")"
    # shellcheck disable=SC1091
    DISTRO_NAME="$(. /etc/os-release; echo "${PRETTY_NAME:-$DISTRO_ID}")"
fi

is_like() {
    case " $DISTRO_ID $DISTRO_LIKE " in *" $1 "*) return 0 ;; esac
    return 1
}

FIRMWARE="BIOS"
[ -d /sys/firmware/efi ] && FIRMWARE="UEFI"

# Native resolution of the first connected display, e.g. 2560x1440.
detect_resolution() {
    local status mode
    for status in /sys/class/drm/card*-*/status; do
        [ -r "$status" ] && [ "$(cat "$status")" = "connected" ] || continue
        mode="$(head -n1 "$(dirname "$status")/modes" 2>/dev/null || true)"
        if [[ "$mode" =~ ^[0-9]+x[0-9]+$ ]]; then
            echo "$mode"
            return
        fi
    done
}
RESOLUTION="$(detect_resolution)"

detect_windows() {
    local esp
    for esp in /boot/efi /efi /boot; do
        [ -d "$esp/EFI/Microsoft" ] && return 0
    done
    command -v lsblk >/dev/null 2>&1 && lsblk -no FSTYPE 2>/dev/null | grep -qx ntfs
}
WINDOWS="no"
if detect_windows; then WINDOWS="yes"; fi

# Bootloader: Fedora / RHEL / openSUSE use "grub2-*" tools and /boot/grub2,
# Debian / Ubuntu / Mint / Arch use "grub-*" tools and /boot/grub.
BOOTLOADER="grub"
if [ -r /etc/sysconfig/bootloader ] && grep -qE '^LOADER_TYPE="?(systemd-boot|grub2-bls)' /etc/sysconfig/bootloader; then
    BOOTLOADER="$(sed -n 's/^LOADER_TYPE="\{0,1\}\([^"]*\)"\{0,1\}/\1/p' /etc/sysconfig/bootloader)"
fi
if command -v grub2-mkconfig >/dev/null 2>&1 && [ -d /boot/grub2 ]; then
    GRUB_DIR="/boot/grub2"
    MKCONFIG="grub2-mkconfig"
elif command -v grub-mkconfig >/dev/null 2>&1; then
    GRUB_DIR="/boot/grub"
    MKCONFIG="grub-mkconfig"
else
    GRUB_DIR=""
    MKCONFIG=""
    [ "$BOOTLOADER" = "grub" ] && BOOTLOADER="not found"
fi
THEME_DIR="${GRUB_DIR:-/boot/grub}/themes/$THEME_NAME"

# Debian-based grub-mkconfig also reads /etc/default/grub.d/*.cfg after
# /etc/default/grub; those files (e.g. Kali's theme) would override ours.
# They are read in alphabetical order, so ours is named to come last.
CONFIG_FILE="$GRUB_DEFAULT_CFG"
if [ -n "$MKCONFIG" ] && [ -d "$GRUB_DROPIN_DIR" ] && grep -q "grub.d" "$(command -v "$MKCONFIG")"; then
    CONFIG_FILE="$GRUB_DROPIN_DIR/zz-one-piece.cfg"
fi

installed_theme() {
    cat "$SHARE_DIR/installed" 2>/dev/null || echo "none"
}

if [ "$ACTION" = "status" ]; then
    cat <<EOF
Distribution : $DISTRO_NAME
Firmware     : $FIRMWARE
Bootloader   : $BOOTLOADER${MKCONFIG:+ ($MKCONFIG, $GRUB_DIR)}
Resolution   : ${RESOLUTION:-unknown}
Windows      : $WINDOWS
os-prober    : $(command -v os-prober >/dev/null 2>&1 && echo installed || echo missing)
Config       : $CONFIG_FILE
Theme        : $(installed_theme)
EOF
    exit 0
fi

[ "$(id -u)" -eq 0 ] || die "Please run as root: sudo $0 $*"

info "Distribution: $DISTRO_NAME | $FIRMWARE | display ${RESOLUTION:-unknown} | Windows: $WINDOWS"

if [ "$DISTRO_ID" = "nixos" ]; then
    cat <<EOF
NixOS manages GRUB declaratively. Assemble the theme into a folder:

  ./setup build ${THEME:-luffy} ./one-piece-theme

and add to configuration.nix:

  boot.loader.grub.theme = ./one-piece-theme;
  boot.loader.grub.useOSProber = true;   # detect Windows

then run: sudo nixos-rebuild switch
EOF
    exit 0
fi

case "$BOOTLOADER" in
    grub) ;;
    systemd-boot|grub2-bls)
        die "This system boots with $BOOTLOADER, which does not use GRUB themes.
    On openSUSE you can switch back to GRUB in YaST > Boot Loader." ;;
    *)
        die "GRUB was not found. This system probably uses another bootloader
    (e.g. Pop!_OS uses systemd-boot). Install GRUB first." ;;
esac
[ -f "$GRUB_DEFAULT_CFG" ] || die "$GRUB_DEFAULT_CFG not found."

update_grub_cfg() {
    info "Regenerating GRUB configuration..."
    if command -v update-grub >/dev/null 2>&1; then
        update-grub
    else
        "$MKCONFIG" -o "$GRUB_DIR/grub.cfg"
    fi
    # Older Fedora/RHEL UEFI installs read a full grub.cfg from the ESP
    # instead of a stub that points to $GRUB_DIR/grub.cfg.
    local efi_cfg="/boot/efi/EFI/$DISTRO_ID/grub.cfg"
    if [ -f "$efi_cfg" ] && ! grep -q "configfile" "$efi_cfg"; then
        "$MKCONFIG" -o "$efi_cfg"
    fi
}

remove_config() {
    rm -f "$GRUB_DROPIN_DIR/zz-one-piece.cfg"
    if grep -qF "$BLOCK_BEGIN" "$GRUB_DEFAULT_CFG"; then
        sed -i "/^$BLOCK_BEGIN\$/,/^$BLOCK_END\$/d" "$GRUB_DEFAULT_CFG"
    fi
}

# The settings are plain shell, sourced by grub-mkconfig after the
# distribution's own values, so nothing in /etc/default/grub is rewritten.
write_config() {
    local mode="${RESOLUTION:-1920x1080},auto" wrap="no"
    remove_config
    if [ "$CONFIG_FILE" = "$GRUB_DEFAULT_CFG" ]; then wrap="yes"; fi
    {
        if [ "$wrap" = "yes" ]; then echo "$BLOCK_BEGIN"; fi
        cat <<EOF
# Added by the One Piece GRUB theme. Remove with: sudo onepiece-setup remove
GRUB_THEME="$THEME_DIR/theme.txt"
# Themes need the graphical terminal (Fedora ships GRUB_TERMINAL_OUTPUT=console).
unset GRUB_TERMINAL
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUB_GFXMODE="\${GRUB_GFXMODE:-$mode}"
# Show the menu instead of hiding it.
GRUB_TIMEOUT_STYLE="menu"
if [ "\${GRUB_TIMEOUT:-0}" = "0" ]; then GRUB_TIMEOUT="10"; fi
# Detect Windows and other systems (disabled by default since GRUB 2.06).
GRUB_DISABLE_OS_PROBER="false"
EOF
        if [ "$wrap" = "yes" ]; then echo "$BLOCK_END"; fi
    } >> "$CONFIG_FILE"
}

install_os_prober() {
    local cmd answer
    if is_like fedora || is_like rhel; then cmd="dnf install -y os-prober"
    elif is_like debian || is_like ubuntu; then cmd="apt-get install -y os-prober"
    elif is_like arch; then cmd="pacman -S --noconfirm --needed os-prober"
    elif is_like suse || is_like opensuse; then cmd="zypper --non-interactive install os-prober"
    else
        warn "Install os-prober with your package manager so Windows appears in the menu."
        return
    fi
    if [ "$ASSUME_YES" -eq 0 ]; then
        if [ ! -t 0 ]; then
            warn "Windows was found but os-prober is missing. Run: sudo $cmd"
            return
        fi
        read -rp "Windows was found but os-prober is missing. Install it now? [Y/n] " answer
        case "${answer:-y}" in [yY]*) ;; *) return ;; esac
    fi
    info "Running: $cmd"
    $cmd || warn "Could not install os-prober. Run it manually: sudo $cmd"
}

# --- Remove -----------------------------------------------------------------
if [ "$ACTION" = "remove" ]; then
    remove_config
    rm -rf "$THEME_DIR"
    update_grub_cfg
    rm -f "$GLOBAL_CMD"
    rm -rf "$SHARE_DIR"
    ok "Theme removed and GRUB settings restored."
    exit 0
fi

# --- Install ----------------------------------------------------------------
info "Installing the '$THEME' theme ($(theme_title "$THEME")) to $THEME_DIR"
assemble_theme "$THEME" "$THEME_DIR"

# Keep a copy of the themes so "onepiece-setup <theme>" works from anywhere.
if [ "$SRC_DIR" != "$SHARE_DIR" ]; then
    rm -rf "$SHARE_DIR"
    mkdir -p "$SHARE_DIR"
    cp -a "$SRC_DIR"/setup "$SRC_DIR"/*.pf2 "$SRC_DIR"/terminal_box_*.png \
          "$SRC_DIR"/icons "$SRC_DIR"/themes "$SRC_DIR"/backgrounds "$SHARE_DIR"/
fi
echo "$THEME" > "$SHARE_DIR/installed"
mkdir -p "$(dirname "$GLOBAL_CMD")"
ln -sf "$SHARE_DIR/setup" "$GLOBAL_CMD"

write_config
ok "GRUB settings written to $CONFIG_FILE"

# Fedora hides the menu after a successful boot.
if command -v grub2-editenv >/dev/null 2>&1; then
    grub2-editenv - unset menu_auto_hide 2>/dev/null || true
fi

if ! command -v os-prober >/dev/null 2>&1; then
    if [ "$WINDOWS" = "yes" ]; then
        install_os_prober
    else
        info "os-prober is not installed; other operating systems will not be listed."
    fi
fi

update_grub_cfg
ok "'$THEME' theme installed. Reboot and set sail!"
ok "Switch themes any time with: sudo onepiece-setup <theme>"
